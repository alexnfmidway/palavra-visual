# Copie para .env.local e preencha. Nunca versione o .env.local.

# Neon: Connection string do projeto (painel do Neon > Connect). Use a versão "pooled".
DATABASE_URL=

# Better Auth: segredo longo e aleatório (ex.: `npx @better-auth/cli secret` ou `openssl rand -base64 32`).
BETTER_AUTH_SECRET=
# URL do app (local: http://localhost:3000; na Vercel: a URL do deploy).
BETTER_AUTH_URL=http://localhost:3000

# Vercel Blob: token do Blob store (Vercel > Storage > Blob > .env.local).
BLOB_READ_WRITE_TOKEN=
STORAGE_PROVIDER=vercel-blob

# Marca provisória (opcional): sobrescreve o nome definido em src/config/brand.config.ts
# NEXT_PUBLIC_BRAND_NAME=Palavra-Visual
# NEXT_PUBLIC_BRAND_SHORT_NAME=Palavra
